{
  "name": "dsh-personal-assistant",
  "version": "0.1.0-alpha.2",
  "private": false,
  "type": "module",
  "description": "Local personal memory, planning and task assistant for DeepSeek Harness",
  "license": "MIT",
  "author": "McLinWxl",
  "repository": {
    "type": "git",
    "url": "https://github.com/McLinWxl/dsh-personal-assistant.git",
    "directory": "plugins/dsh-personal-assistant"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.1-rc.5"
  },
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./agent": "./lib/agent.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/host.js",
    "lib/agent.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/zones.json",
    "locale/en.json",
    "locale/zh.json",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "check:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@touch4it/ical-timezones": "1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.28.2",
    "ical.js": "2.2.1",
    "js-yaml": "5.5.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2"
  }
}
